
@model VERSUM.KitchenWareERP.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="page-heading">
    <h1>Delete Category</h1>
    <p>Review the category before removing it.</p>
</div>

<div class="panel versum-form danger-panel">

    <h5>Are you sure you want to delete this category?</h5>

    <p class="text-muted">
        Category: <strong>@Model.Name</strong>
    </p>

    <p class="small text-danger">
        This action cannot be undone.
        Categories containing products cannot be deleted.
    </p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-actions">
            <button type="submit" class="btn btn-danger">
                Confirm Delete
            </button>

            <a asp-action="Index"
               class="versum-btn versum-btn-outline">
                Cancel
            </a>
        </div>
    </form>
</div>
