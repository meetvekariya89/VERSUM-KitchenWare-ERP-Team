
@model IEnumerable<VERSUM.KitchenWareERP.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="page-heading">
    <h1>Product Categories</h1>
    <p>Organize and manage your kitchenware product groups.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="versum-alert">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel">

    <div class="inventory-toolbar">
        <form asp-action="Index" method="get"
              class="inventory-search">

            <input type="search"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search categories..." />

            <button type="submit" class="versum-btn">
                <i class="bi bi-search"></i> Search
            </button>

            <a asp-action="Index"
               class="versum-btn versum-btn-outline">
                Reset
            </a>
        </form>

        <a asp-action="Create" class="versum-btn">
            <i class="bi bi-plus-lg"></i>
            Add Category
        </a>
    </div>

    <div class="inventory-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Description</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="action-links">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="delete-link">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            No categories found.
                            Click Add Category to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
