@model VERSUM.KitchenWareERP.Models.Dealer

@{
    ViewData["Title"] = "Add Dealer";
}

<div class="page-heading">
    <div>
        <h1>Add Dealer</h1>
        <p>Register a new dealer or distributor.</p>
    </div>
</div>

<div class="panel versum-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <partial name="_DealerForm" model="Model" />

        <div class="form-actions">
            <button type="submit" class="versum-btn">
                Save Dealer
            </button>
            <a asp-action="Index"
               class="versum-btn versum-btn-outline">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
