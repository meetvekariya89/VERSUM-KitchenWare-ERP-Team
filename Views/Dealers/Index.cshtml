@model IEnumerable<VERSUM.KitchenWareERP.Models.Dealer>

@{
    ViewData["Title"] = "Dealers Management";

    // Check administrator permissions
    var isAdmin = User.IsInRole("Admin");
}

<div class="page-heading">

    <div>
        <h1>Dealers Management</h1>
        <p>Manage dealers and distributors.</p>
    </div>

    <!-- ADD DEALER: ADMIN ONLY -->
    @if (isAdmin)
    {
        <a asp-action="Create" class="versum-btn">
            <i class="bi bi-plus-circle"></i> Add Dealer
        </a>
    }

</div>

<div class="panel">

    <!-- SEARCH DEALERS: ADMIN AND STAFF -->

    <form method="get"
          asp-action="Index"
          class="d-flex gap-2 mb-3">

        <input name="search"
               type="search"
               value="@ViewBag.Search"
               class="versum-input"
               placeholder="Search dealers..." />

        <button type="submit" class="versum-btn">
            Search
        </button>

    </form>

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>Code</th>
                    <th>Dealer Name</th>
                    <th>Contact</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>GSTIN</th>
                    <th>Status</th>

                    <!-- ACTIONS COLUMN: ADMIN ONLY -->
                    @if (isAdmin)
                    {
                        <th>Actions</th>
                    }

                </tr>

            </thead>

            <tbody>

                @foreach (var d in Model)
                {
                    <tr>

                        <td>
                            <strong>@d.DealerCode</strong>
                        </td>

                        <td>@d.Name</td>

                        <td>@(d.ContactPerson ?? "-")</td>

                        <td>@d.Phone</td>

                        <td>@d.City</td>

                        <td>@(d.GSTNumber ?? "-")</td>

                        <!-- DEALER STATUS -->

                        <td>

                            <span class="versum-status @(d.IsActive ? "versum-status-active" : "versum-status-inactive")">

                                @(d.IsActive ? "Active" : "Inactive")

                            </span>

                        </td>

                        <!-- EDIT AND DELETE: ADMIN ONLY -->
                        @if (isAdmin)
                        {
                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@d.Id">
                                    Edit
                                </a>

                                |

                                <a asp-action="Delete"
                                   asp-route-id="@d.Id"
                                   class="text-danger">
                                    Delete
                                </a>

                            </td>
                        }

                    </tr>
                }

                <!-- EMPTY DEALER LIST -->
                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="@(isAdmin ? 8 : 7)"
                            class="text-center py-4">

                            No dealers found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
