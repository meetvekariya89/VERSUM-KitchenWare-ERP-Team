@model VERSUM.KitchenWareERP.Models.Purchase

@{
    ViewData["Title"] = "New Purchase";
}

<div class="page-heading">
    <div>
        <h1>New Purchase</h1>
        <p>Record raw material purchases and update stock.</p>
    </div>
</div>

<div class="panel versum-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <h5 class="mb-3">Purchase Information</h5>

        <div class="row">
            <div class="col-md-6">
                <div class="form-field">
                    <label asp-for="PurchaseNumber">
                        Purchase Number
                    </label>
                    <input asp-for="PurchaseNumber"
                           class="versum-input" />
                    <span asp-validation-for="PurchaseNumber"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-field">
                    <label asp-for="PurchaseDate">
                        Purchase Date
                    </label>
                    <input asp-for="PurchaseDate"
                           type="date"
                           class="versum-input" />
                    <span asp-validation-for="PurchaseDate"
                          class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-field">
                    <label asp-for="SupplierName">
                        Supplier Name
                    </label>
                    <input asp-for="SupplierName"
                           class="versum-input"
                           placeholder="Enter supplier name" />
                    <span asp-validation-for="SupplierName"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-field">
                    <label asp-for="InvoiceNumber">
                        Supplier Invoice Number
                    </label>
                    <input asp-for="InvoiceNumber"
                           class="versum-input"
                           placeholder="Optional invoice number" />
                    <span asp-validation-for="InvoiceNumber"
                          class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr />

        <h5 class="mb-3">Raw Material Details</h5>

        <div class="form-field">
            <label asp-for="RawMaterialId">
                Select Raw Material
            </label>
            <select asp-for="RawMaterialId"
                    asp-items="ViewBag.RawMaterials"
                    class="versum-input">
                <option value="">-- Select Raw Material --</option>
            </select>
            <span asp-validation-for="RawMaterialId"
                  class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-field">
                    <label asp-for="Quantity">Quantity</label>
                    <input asp-for="Quantity"
                           type="number"
                           step="0.001"
                           min="0.001"
                           class="versum-input"
                           id="purchaseQuantity" />
                    <span asp-validation-for="Quantity"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-field">
                    <label asp-for="UnitPrice">
                        Purchase Rate (₹)
                    </label>
                    <input asp-for="UnitPrice"
                           type="number"
                           step="0.01"
                           min="0"
                           class="versum-input"
                           id="purchaseRate" />
                    <span asp-validation-for="UnitPrice"
                          class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="panel mb-3"
             style="background:#F4F6F8;">
            <div class="d-flex justify-content-between align-items-center">
                <strong>Estimated Total</strong>
                <h3 class="mb-0" id="purchaseTotal">
                    ₹0.00
                </h3>
            </div>
        </div>

        <div class="form-field">
            <label asp-for="Remarks">Remarks</label>
            <textarea asp-for="Remarks"
                      rows="3"
                      class="versum-input"
                      placeholder="Optional purchase notes"></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="versum-btn">
                <i class="bi bi-check-circle"></i>
                Save Purchase & Update Stock
            </button>

            <a asp-action="Index"
               class="versum-btn versum-btn-outline">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const quantity = document.getElementById("purchaseQuantity");
            const rate = document.getElementById("purchaseRate");
            const total = document.getElementById("purchaseTotal");

            function updateTotal() {
                const q = parseFloat(quantity.value) || 0;
                const r = parseFloat(rate.value) || 0;

                const amount = q * r;

                total.textContent = "₹" + amount.toLocaleString(
                    "en-IN",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );
            }

            quantity.addEventListener("input", updateTotal);
            rate.addEventListener("input", updateTotal);

            updateTotal();
        })();
    </script>
}
