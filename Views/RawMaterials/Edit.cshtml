@model VERSUM.KitchenWareERP.Models.RawMaterial

@{
    ViewData["Title"] = "Edit Raw Material";
}

<div class="page-heading">
    <div>
        <h1>Edit Raw Material</h1>
        <p>Update material details and available stock.</p>
    </div>
</div>

<div class="panel versum-form">
    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <partial name="_MaterialForm" model="Model" />

        <div class="form-actions">
            <button type="submit" class="versum-btn">
                Update Material
            </button>
            <a asp-action="Index"
               class="versum-btn versum-btn-outline">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
  