@model IEnumerable<VERSUM.KitchenWareERP.Models.RawMaterial>

@{
    ViewData["Title"] = "Raw Materials";
}

<div class="page-heading">
    <div>
        <h1>Raw Materials</h1>
        <p>Manage manufacturing materials and inventory.</p>
    </div>
    <a asp-action="Create" class="versum-btn">
        <i class="bi bi-plus-circle"></i> Add Material
    </a>
</div>

<div class="panel">
    <form method="get" asp-action="Index"
          class="mb-3 d-flex gap-2">
        <input type="search"
               name="search"
               value="@ViewBag.Search"
               class="versum-input"
               placeholder="Search materials..." />
        <button class="versum-btn" type="submit">
            Search
        </button>
    </form>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Material</th>
                    <th>Stock</th>
                    <th>Minimum</th>
                    <th>Cost / Unit</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.MaterialCode</td>
                        <td>@m.Name</td>
                        <td>
                            @m.CurrentStock.ToString("N3") @m.Unit
                            @if (m.CurrentStock <= m.MinimumStock)
                            {
                                <span class="text-danger">
                                    Low
                                </span>
                            }
                        </td>
                        <td>@m.MinimumStock.ToString("N3") @m.Unit</td>
                        <td>₹@m.CostPerUnit.ToString("N2")</td>
                        <td>@(m.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@m.Id">Edit</a>
                            |
                            <a asp-action="Delete"
                               asp-route-id="@m.Id"
                               class="text-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            No raw materials found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
  